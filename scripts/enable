#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: scripts/enable <repository> <user-home>" >&2
  exit 2
fi

repository=$1
user_home=$2

case "$repository:$user_home" in
  /*:/*) ;;
  *)
    echo "enable requires absolute repository and user-home paths" >&2
    exit 2
    ;;
esac

repository=$(git -C "$repository" rev-parse --show-toplevel)
authoritah_home=$user_home/.local/share/authoritah
runtime_skill=$authoritah_home/skills/authoritah
agents_skill=$repository/.agents/skills/authoritah
claude_skill=$repository/.claude/skills/authoritah

if [ ! -f "$runtime_skill/SKILL.md" ]; then
  echo "enable requires the Authoritah runtime skill: $runtime_skill/SKILL.md" >&2
  exit 1
fi

preflight_link() {
  target=$1
  link=$2

  if [ -L "$link" ]; then
    if ! linked_root=$(cd "$link" 2>/dev/null && pwd -P); then
      echo "enable refused broken link: $link" >&2
      exit 1
    fi
    target_root=$(cd "$target" && pwd -P)
    if [ "$linked_root" != "$target_root" ]; then
      echo "enable refused existing link with another target: $link" >&2
      exit 1
    fi
    return
  fi
  if [ -e "$link" ]; then
    echo "enable refused existing path: $link" >&2
    exit 1
  fi
}

link_directory() {
  target=$1
  link=$2

  if [ -L "$link" ]; then
    if [ "$(readlink "$link")" = "$target" ]; then
      return
    fi
    unlink "$link"
  fi
  mkdir -p "$(dirname "$link")"
  ln -s "$target" "$link"
}

preflight_link "$runtime_skill" "$agents_skill"
preflight_link "$runtime_skill" "$claude_skill"

exclude_file=$(git -C "$repository" rev-parse --git-path info/exclude)
case "$exclude_file" in
  /*) ;;
  *) exclude_file=$repository/$exclude_file ;;
esac

if [ ! -f "$exclude_file" ] || [ ! -w "$exclude_file" ]; then
  echo "enable requires a writable Git exclude file: $exclude_file" >&2
  exit 1
fi

link_directory "$runtime_skill" "$agents_skill"
link_directory "$runtime_skill" "$claude_skill"

for ignored_path in /.agents/skills/authoritah /.claude/skills/authoritah; do
  if ! grep -Fqx "$ignored_path" "$exclude_file"; then
    printf '%s\n' "$ignored_path" >> "$exclude_file"
  fi
done

echo "Authoritah enabled: $repository"
echo "Runtime skill: $agents_skill"
